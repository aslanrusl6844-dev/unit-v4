# ---- Сервер ----
PORT=3000
NODE_ENV=development

# ---- База данных (Neon — бесплатный serverless Postgres) ----
# Зайдите на neon.tech (или подключите через маркетплейс интеграций Vercel),
# создайте бесплатный проект и скопируйте оттуда две строки подключения:
#   DATABASE_URL — "pooled" соединение (через PgBouncer) — использует сервер в рантайме
#   DIRECT_URL   — "direct" соединение — нужно для миграций (prisma migrate deploy)
# Если Neon даёт только одну строку — используйте её в обоих местах, тоже сработает.
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Kaspi.kz Магазин API ----
# Токен берётся в кабинете продавца: Магазин на Kaspi.kz -> Настройки -> API
KASPI_API_TOKEN=your_kaspi_x_auth_token
KASPI_MERCHANT_UID=your_merchant_id
KASPI_API_BASE_URL=https://kaspi.kz/shop/api/v2
# Зона доставки по умолчанию для расчёта тарифа Kaspi Доставки: city | kazakhstan | express
KASPI_DEFAULT_DELIVERY_ZONE=kazakhstan

# ---- Ozon Seller API ----
# Client-Id и Api-Key берутся в личном кабинете продавца: Настройки -> Seller API
OZON_CLIENT_ID=your_ozon_client_id
OZON_API_KEY=your_ozon_api_key
OZON_API_BASE_URL=https://api-seller.ozon.ru

# ---- Wildberries Statistics API ----
# Токен создаётся в личном кабинете: Профиль -> Настройки -> Доступ к API.
# ВАЖНО: для этого сервера нужен токен категории "Статистика" (Statistics),
# не "Стандартный" — иначе методы заказов/отчётов не будут работать.
WB_API_TOKEN=your_wb_statistics_token
WB_STATS_API_BASE_URL=https://statistics-api.wildberries.ru

# ---- Синхронизация (используется только локально, npm run dev — на Vercel см. ниже) ----
# Крон-выражение для автосинхронизации заказов (по умолчанию каждые 30 минут)
SYNC_CRON="*/30 * * * *"
# Сколько дней истории подтягивать при первом запуске
SYNC_INITIAL_LOOKBACK_DAYS=30

# ---- Автобот снижения цены на Kaspi (используется только локально, npm run dev) ----
# Как часто проверять цены конкурентов и пересчитывать целевую цену (по умолчанию каждые 15 минут).
# Помните: сам Kaspi обновит цены на сайте примерно раз в час — это его ограничение, не наше.
REPRICER_CRON="*/15 * * * *"
# Секретный токен для ссылки на прайс-лист (?token=...), чтобы её не мог дёргать кто попало.
# Придумайте любую длинную случайную строку.
PRICE_FEED_SECRET=change_me_to_random_string

# ---- Фоновые задачи на Vercel (продакшен) ----
# На Vercel нет постоянно работающего процесса — синхронизация и автобот цены
# запускаются по HTTP-запросу на /api/cron/sync и /api/cron/reprice.
# Придумайте здесь свою длинную случайную строку (другую, не такую же как PRICE_FEED_SECRET) —
# она нужна и штатному Vercel Cron (раз в сутки на бесплатном тарифе), и внешнему
# планировщику вроде cron-job.org, если настроите более частый запуск (см. README).
CRON_SECRET=change_me_to_another_random_string
