// Схема базы данных для учёта юнит-экономики Kaspi Магазин + Ozon

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Marketplace {
  KASPI
  OZON
  WB
}

enum RepriceStrategy {
  FIRST_PLACE   // Быть на 1-м месте: дешевле самого дешёвого конкурента на "шаг"
  MATCH_FIRST   // Цена конкурента на 1 месте: точно как у лидера, без снижения
  STICK_TO_FIRST // Прижиматься к первому: подстраивается, но не дёргает цену по мелочи
  SECOND_PLACE  // Быть 2-м: чуть дороже лидера, но дешевле остальных
}

// Настройки подключения к Kaspi Магазин — вводятся через форму «Добавить
// магазин» в разделе «Настройки», а не только через переменные окружения.
// Одна запись = один магазин (мульти-магазин можно добавить позже).
model KaspiStore {
  id             String   @id @default(cuid())
  name           String
  bin            String?  // БИН — необязательно, для справки
  contactPhone   String?
  contactEmail   String?
  apiToken       String   // X-Auth-Token — обязательное поле, используется для всех запросов к Kaspi
  merchantUid    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Подключение к Ozon Seller API — через форму в разделе «Настройки»,
// аналогично KaspiStore. Один магазин на сервер.
model OzonStore {
  id          String   @id @default(cuid())
  clientId    String
  apiKey      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Подключение к Wildberries — через форму в разделе «Настройки», по
// аналогии с KaspiStore/OzonStore. Один и тот же токен используется и для
// Statistics API (заказы/отчёт о реализации), и для Content API (карточки
// товаров) — если у токена нет нужной категории доступа, конкретный метод
// вернёт ошибку авторизации, но остальные продолжат работать.
model WbStore {
  id          String   @id @default(cuid())
  apiToken    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Ставка налога ИП — настраивается в разделе «Настройки», по умолчанию 4%
// (упрощённый режим: налог считается от ВЫРУЧКИ, а не от прибыли). Одна
// запись на сервер.
model TaxSettings {
  id        String   @id @default(cuid())
  ratePct   Float    @default(4)
  updatedAt DateTime @updatedAt
}

// Карточка товара с себестоимостью — основа для расчёта юнит-экономики.
// Один товар может продаваться на обеих площадках, поэтому храним оба SKU.
model Product {
  id          String   @id @default(cuid())
  sku         String   @unique // внутренний SKU/артикул
  name        String
  costPrice   Float    @default(0) // закупочная себестоимость за единицу
  packagingCost Float  @default(0) // упаковка/расходники за единицу (опционально)
  weightKg    Float    @default(0.5) // вес единицы товара — нужен для расчёта тарифа Kaspi Доставки
  kaspiSku    String?  @unique // артикул товара в Kaspi Магазин
  kaspiTopCategory String? // категория 1-го уровня в Kaspi (для расчёта комиссии)
  kaspiLeafCategory String? // самая точная категория товара в Kaspi (для расчёта комиссии)
  ozonOfferId String?  @unique // offer_id товара в Ozon
  ozonSku     Int?     // числовой sku Ozon (если известен)
  wbArticle   String?  @unique // артикул продавца (supplierArticle) в Wildberries
  wbNmId      Int?     // числовой артикул WB (nmId), для справки
  active      Boolean  @default(true)
  // Лучшая известная ТЕКУЩАЯ цена продажи — ОТДЕЛЬНО по каждой площадке
  // (один и тот же товар может стоить и продаваться на Kaspi/Ozon/WB
  // по-разному, с разной комиссией и логистикой каждой площадки).
  // Обновляется двумя способами: (1) живыми данными из API площадки при
  // синхронизации каталога (сейчас так для Ozon — API отдаёт price прямо
  // в ответе); (2) ценой последней фактической продажи ИМЕННО НА ЭТОЙ
  // площадке (для Kaspi/WB, у которых нет отдельного метода "текущая цена
  // товара"). На основе этих полей считается ПРОГНОЗНАЯ юнит-экономика по
  // каждой площадке в каталоге — даже если по товару ещё не было продаж.
  kaspiReferencePrice          Float?
  kaspiReferencePriceUpdatedAt DateTime?
  ozonReferencePrice           Float?
  ozonReferencePriceUpdatedAt  DateTime?
  wbReferencePrice             Float?
  wbReferencePriceUpdatedAt    DateTime?

  // --- Предварительные расходы Ozon по тарифу (POST /v5/product/info/prices) ---
  // Это ТА ЖЕ тарифная сетка, что видна в кабинете Ozon → Цены и акции →
  // Управление ценами → "Расходы". НЕ факт по реальной продаже — предварительная
  // оценка "если продать по этой цене сейчас", может отличаться от факта из-за
  // акций/фактического веса при приёмке. Обновляется при синхронизации каталога
  // Ozon (кнопка «Каталог Ozon»). Схема FBS выбрана как основная (самая частая
  // для обычных продавцов).
  ozonCommissionRatePct     Float?   // commissions.sales_percent_fbs, % от цены — "Вознаграждение Ozon"
  ozonLogisticsAmount       Float?   // fbs_direct_flow_trans_min_amount — магистральная логистика, ₸
  ozonLastMileAmount        Float?   // fbs_deliv_to_customer_amount — последняя миля, ₸
  ozonReturnLogisticsAmount Float?   // fbs_return_flow_amount — обратная логистика (если товар вернут), ₸ — справочно, не входит в прогноз прибыли
  ozonAcquiringAmount       Float?   // acquiring — эквайринг, ₸
  ozonTariffsUpdatedAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Автобот снижения цены на Kaspi ---
  kaspiProductUrl    String?  // ссылка на карточку товара на kaspi.kz (откуда читаем цены конкурентов)
  autoRepriceEnabled Boolean  @default(false)
  minPrice           Float?   // минимальная цена — граница, ниже которой бот не опустится
  maxPrice           Float?   // максимальная цена — граница, выше которой бот не поднимет (опционально)
  repriceStep        Float    @default(1) // на сколько ₸ быть дешевле конкурента / шаг корректировки
  repriceStrategy    RepriceStrategy @default(FIRST_PLACE)
  currentKaspiPrice  Float?   // текущая цена, которую бот выставил (уходит в фид для Kaspi)
  lastRepricedAt     DateTime?

  // --- Отзывы (снимок с публичной страницы товара) ---
  kaspiRating        Float?
  kaspiReviewCount   Int?
  reviewsUpdatedAt   DateTime?

  orderItems  OrderItem[]
  priceHistory PriceHistory[]

  @@index([kaspiSku])
  @@index([ozonOfferId])
}

// История изменений цены автоботом — чтобы видеть, что и когда происходило.
model PriceHistory {
  id               String   @id @default(cuid())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  oldPrice         Float?
  newPrice         Float
  lowestCompetitorPrice Float?
  hitFloor         Boolean  @default(false) // true, если цену пришлось ограничить minPrice
  createdAt        DateTime @default(now())

  @@index([productId])
}

// Заказ с площадки. Финансовые поля — это то, что фактически удержала площадка
// (комиссия, логистика, эквайринг и т.д.), полученное из финансовых отчётов API.
model Order {
  id                     String      @id @default(cuid())
  marketplace            Marketplace
  externalId             String      // Kaspi: order code; Ozon: posting_number
  status                 String
  orderDate              DateTime
  deliveryType           String?     // самовывоз/курьер, FBS/FBO и т.п.
  city                   String?
  kaspiInternalId        String?     // внутренний id заказа в Kaspi (не code!), нужен для API-запросов на статус
  numberOfSpace          Int?        // количество мест — указывается при формировании накладной
  waybillGeneratedAt     DateTime?   // когда сформировали накладную (перевели в ASSEMBLE)

  totalRevenue           Float       @default(0) // сумма продажи (то, что заплатил клиент)
  marketplaceCommission  Float       @default(0) // комиссия площадки
  logisticsCost          Float       @default(0) // доставка/логистика/фулфилмент
  acquiringCost          Float       @default(0) // эквайринг/платёжная комиссия (Kaspi)
  otherFees              Float       @default(0) // прочие удержания
  adSpendAllocated        Float       @default(0) // распределённые расходы на рекламу (при пересчёте)

  rawData                String?     // JSON исходного ответа API — для отладки/аудита

  items                  OrderItem[]

  createdAt              DateTime    @default(now())
  updatedAt               DateTime   @updatedAt

  @@unique([marketplace, externalId])
  @@index([marketplace, orderDate])
  @@index([status])
}

// Позиция заказа. costPrice — себестоимость на момент продажи (снапшот),
// чтобы изменение цены закупки в будущем не искажало историю.
model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?

  externalSku String   // артикул/offer_id как он пришёл с площадки
  name        String
  quantity    Int      @default(1)
  price       Float    // цена продажи за единицу
  costPrice   Float    @default(0) // себестоимость за единицу (снапшот из Product)

  // Комиссия и логистика ЭТОЙ позиции — считаются и сохраняются один раз,
  // в момент синхронизации (см. src/services/sync.service.ts), а не
  // восстанавливаются задним числом из суммы по заказу. Для Kaspi комиссия
  // считается по официальной ставке КАТЕГОРИИ ИМЕННО ЭТОГО товара (в одном
  // заказе могут быть товары из разных категорий с разными ставками), а
  // логистика распределяется между позициями по ВЕСУ (не по выручке) —
  // тариф Kaspi Доставки зависит от веса. Это и есть "точный разнос".
  commission    Float @default(0)
  itemLogistics Float @default(0)

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([externalSku])
}

// Расходы на рекламу/продвижение — вносятся вручную, т.к. не всегда доступны через API.
model AdSpend {
  id          String      @id @default(cuid())
  marketplace Marketplace
  date        DateTime
  amount      Float
  note        String?
  createdAt   DateTime    @default(now())
}

// Прочие ручные операционные расходы (упаковка оптом, хранение, зарплата и т.п.),
// которые нужно учитывать в общей юнит-экономике, но которые не приходят из API.
model ManualExpense {
  id          String      @id @default(cuid())
  marketplace Marketplace?
  category    String      // напр. "Хранение", "ФОТ", "Упаковка"
  date        DateTime
  amount      Float
  note        String?
  createdAt   DateTime    @default(now())
}

// Журнал синхронизаций — для мониторинга и отладки интеграций.
model SyncLog {
  id              String      @id @default(cuid())
  marketplace     Marketplace
  status          String      // RUNNING | SUCCESS | ERROR
  message         String?
  ordersProcessed Int         @default(0)
  startedAt       DateTime    @default(now())
  finishedAt      DateTime?
}
