{
  "name": "kaspi-ozon-unit-economics",
  "version": "1.0.0",
  "description": "Сервер учёта юнит-экономики для Kaspi Магазин, Ozon и Wildberries (деплой на Vercel)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json; mkdir -p dist/assets/fonts && cp src/assets/fonts/*.ttf dist/assets/fonts/",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "sync:kaspi": "tsx src/scripts/runSyncKaspi.ts",
    "sync:ozon": "tsx src/scripts/runSyncOzon.ts",
    "sync:wb": "tsx src/scripts/runSyncWb.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@vercel/blob": "^0.27.0",
    "bwip-js": "^4.5.1",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.13.5",
    "@types/multer": "^1.4.12",
    "@types/qrcode": "^1.5.5",
    "@types/node-cron": "^3.0.11",
    "@vercel/node": "^3.2.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
