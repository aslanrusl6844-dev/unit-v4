AAC;CACzB,WAAW,MAAM,KAAK,MAAmC,MAAM,KAAK,OAAO,KAAK,CAAC,CAAC;CAClF,OAAO,OAAO,OAAO,KAAK;AAC5B;;AAGO,eAAe,iBAAiB,UAAkB,OAAe,UAAkB,aAAqB,UAA2D;CACxK,IAAI,CAAC,eAAe,GAAG,MAAM,IAAI,wBAAwB,kBAAkB,MAAM;CACjF,MAAM,OAAO,MAAM,KAAK,EAAE,QAAQ,MAAM,IAAI,GAAG,MAAM,SAAS,UAAU,CAAC,CAAC;CAC1E,MAAM,QAAkB,CAAC;CACzB,IAAI,QAAQ;CACZ,IAAI;EACF,KAAK,MAAM,OAAO,MAAM;GACtB,MAAM,IAAI,MAAM,SAAS,CAAC,CAAC,KAAK,IAAI,uCAAiB;IAAE,QAAQ,0BAAI,GAAG;IAAQ;GAAI,CAAC,CAAC;GACpF,MAAM,MAAM,MAAM,SAAU,EAAU,IAAI;GAC1C,SAAS,IAAI;GACb,IAAI,QAAQ,UAAU,MAAM,IAAI,MAAM,yBAAyB;GAC/D,MAAM,KAAK,GAAG;EAChB;CACF,SAAS,KAAU;EACjB,IAAI,KAAK,SAAS,aAAa,MAAM,IAAI,wBAAwB,2DAA2D,MAAM,GAAG;EACrI,IAAI,eAAe,SAAS,IAAI,YAAY,2BAA2B,MAAM,IAAI,wBAAwB,oCAAoC,MAAM,GAAG;EACtJ,MAAM,IAAI,wBAAwB,6BAA6B,YAAY,GAAG,KAAK,MAAM,GAAG;CAC9F;CACA,MAAM,WAAW,gBAAgB,QAAQ;CACzC,IAAI;EACF,MAAM,SAAS,CAAC,CAAC,KAAK,IAAI,uCAAiB;GACzC,QAAQ,0BAAI,GAAG;GAAQ,KAAK;GAAU,MAAM,OAAO,OAAO,KAAK;GAAG,aAAa;GAC/E,cAAc;EAChB,CAAC,CAAC;CACJ,SAAS,KAAK;EACZ,MAAM,IAAI,wBAAwB,6BAA6B,YAAY,GAAG,KAAK,MAAM,GAAG;CAC9F;CACA,MAAM,SAAS,CAAC,CAAC,KAAK,IAAI,2CAAqB;EAAE,QAAQ,0BAAI,GAAG;EAAQ,QAAQ;GAAE,SAAS,KAAK,KAAK,SAAS,EAAE,IAAI,EAAE;GAAG,OAAO;EAAK;CAAE,CAAC,CAAC,CAAC,CACvI,OAAO,QAAQ,6BAAO,KAAK,EAAE,KAAK,OAAO,KAAK,WAAW,GAAG,EAAE,GAAG,sCAAsC,CAAC;CAC3G,6BAAO,KAAK;EAAE,SAAS;EAAM;EAAU;EAAO,QAAQ;CAAM,GAAG,kDAAkD;CACjH,OAAO;EAAE,KAAK,YAAY,QAAQ;EAAG;CAAM;AAC7C","names":[],"ignoreList":[],"sources":["mediaStorage.service.ts"],"sourcesContent":["/**\n * Хранилище фото/видео My Market.\n *\n * ВИДЕО (video/mp4, video/webm) идут в Cloudflare R2 (бакет mymarket-videos), если заданы\n * R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY и R2_PUBLIC_URL. Фото и всё остальное —\n * по-старому в Vercel Blob. Без R2 видео тоже идут в Blob, чтобы деплой ничего не сломал.\n * Старые ссылки на Blob, уже лежащие в базе, не трогаем — они продолжают открываться.\n *\n * Большие файлы (видео 10–50 МБ) нельзя пропустить через сервер: Vercel режет тело\n * запроса примерно на 4.5 МБ ДО нашего кода, и никакой multipart или лимит\n * express.json() это не обходит. Поэтому для них сервер выдаёт одноразовую подписанную\n * ссылку (presigned PUT), и браузер кладёт файл прямо в R2, минуя Vercel.\n */\nimport { S3Client, PutObjectCommand, GetObjectCommand, DeleteObjectsCommand, ListObjectsV2Command } from '@aws-sdk/client-s3';\nimport { getSignedUrl } from '@aws-sdk/s3-request-presigner';\nimport { put } from '@vercel/blob';\nimport { env } from '../config/env';\nimport { logger } from '../utils/logger';\n\nexport type StorageKind = 'r2' | 'blob';\n\nexport class StorageUnavailableError extends Error {\n  constructor(message: string, readonly storage: StorageKind | 'none', readonly cause?: unknown) {\n    super(message);\n    this.name = 'StorageUnavailableError';\n  }\n}\n\n/** Заданы ли все пять R2_* переменных. */\nexport function isR2Configured(): boolean {\n  const r = env.r2;\n  return !!(r.accountId && r.accessKeyId && r.secretAccessKey && r.bucket && r.publicUrl);\n}\n\nexport const isVideoType = (contentType: string) => contentType.startsWith('video/');\n\n/** Куда пойдёт новая загрузка этого типа: видео — в R2 (если настроен), остальное — в Blob. */\nexport function activeStorage(contentType = 'video/mp4'): StorageKind | 'none' {\n  if (isVideoType(contentType) && isR2Configured()) return 'r2';\n  if (env.blobToken) return 'blob';\n  return 'none';\n}\n\nlet client: S3Client | null = null;\nfunction r2Client(): S3Client {\n  if (!client) {\n    client = new S3Client({\n      region: 'auto',\n      endpoint: `https://${env.r2.accountId}.r2.cloudflarestorage.com`,\n      credentials: { accessKeyId: env.r2.accessKeyId, secretAccessKey: env.r2.secretAccessKey },\n      // Без автоматических CRC32-заголовков: presigned PUT из браузера должен совпадать 1:1.\n      requestChecksumCalculation: 'WHEN_REQUIRED',\n      responseChecksumValidation: 'WHEN_REQUIRED',\n    });\n  }\n  return client;\n}\n\n/** Ключи объектов R2 по префиксу (до 1000) — например, файлы записи эфира. */\nexport async function r2ListKeys(prefix: string): Promise<string[]> {\n  if (!isR2Configured()) return [];\n  const r = await r2Client().send(new ListObjectsV2Command({ Bucket: env.r2.bucket, Prefix: prefix, MaxKeys: 1000 }));\n  return (r.Contents ?? []).map((o) => o.Key ?? '').filter(Boolean);\n}\n\n/** Удалить все объекты R2 в «папке» (например, запись эфира live/<id>/). Возвращает сколько удалено. */\nexport async function r2DeletePrefix(prefix: string): Promise<number> {\n  if (!isR2Configured() || !prefix.endsWith('/') || prefix.length < 4) return 0;\n  let total = 0;\n  for (let round = 0; round < 20; round++) {\n    const keys = await r2ListKeys(prefix);\n    if (!keys.length) break;\n    await r2Client().send(new DeleteObjectsCommand({ Bucket: env.r2.bucket, Delete: { Objects: keys.map((Key) => ({ Key })), Quiet: true } }));\n    total += keys.length;\n    if (keys.length < 1000) break;\n  }\n  return total;\n}\n\n/** Публичная ссылка на объект R2: `${R2_PUBLIC_URL}/${pathname}` — она и сохраняется в базу. */\nexport function r2PublicUrl(pathname: string): string {\n  return `${env.r2.publicUrl}/${pathname.split('/').map(encodeURIComponent).join('/')}`;\n}\n\nfunction safeName(filename: string): string {\n  return filename.replace(/[^a-zA-Z0-9._-]/g, '_').slice(-120) || 'file';\n}\n\n/** Путь в Vercel Blob — ровно как было: shop/<папка>/<время>-<имя>. */\nexport function buildMediaPath(folder: string, filename: string): string {\n  return `shop/${folder}/${Date.now()}-${filename.replace(/[^a-zA-Z0-9._-]/g, '_')}`;\n}\n\n/** Имя видео в бакете R2 (в корне бакета): <время>-<случайное>-<имя>.mp4. */\nexport function buildR2VideoKey(filename: string): string {\n  return `${Date.now()}-${Math.random().toString(36).slice(2, 8)}-${safeName(filename)}`;\n}\n\n/** Сохранить файл (через сервер — только небольшие, до ~3 МБ). Возвращает публичную ссылку. */\nexport async function uploadPublicFile(folder: string, filename: string, buffer: Buffer, contentType: string): Promise<{ url: string; storage: StorageKind }> {\n  const storage = activeStorage(contentType);\n  if (storage === 'r2') {\n    const pathname = buildR2VideoKey(filename);\n    try {\n      await r2Client().send(new PutObjectCommand({\n        Bucket: env.r2.bucket,\n        Key: pathname,\n        Body: buffer,\n        ContentType: contentType,\n        CacheControl: 'public, max-age=31536000, immutable',\n      }));\n    } catch (err) {\n      throw new StorageUnavailableError(`Cloudflare R2 недоступен: ${r2ErrorText(err)}`, 'r2', err);\n    }\n    const url = r2PublicUrl(pathname);\n    logger.info({ storage: 'r2', pathname, bytes: buffer.length }, '[Media] файл сохранён в R2');\n    return { url, storage: 'r2' };\n  }\n  if (storage === 'blob') {\n    const pathname = buildMediaPath(folder, filename);\n    try {\n      const blob = await put(pathname, buffer, { access: 'public', contentType, token: env.blobToken });\n      logger.info({ storage: 'blob', pathname, bytes: buffer.length }, '[Media] файл сохранён в Vercel Blob');\n      return { url: blob.url, storage: 'blob' };\n    } catch (err: any) {\n      throw new StorageUnavailableError(`Vercel Blob недоступен: ${String(err?.message ?? err)}`, 'blob', err);\n    }\n  }\n  throw new StorageUnavailableError('Хранилище не настроено: задайте R2_* или BLOB_READ_WRITE_TOKEN', 'none');\n}\n\n/**\n * Одноразовая ссылка для загрузки прямо из браузера в R2 (действует 10 минут).\n * Браузер делает PUT на uploadUrl с тем же Content-Type — файл в Vercel не попадает.\n */\nexport async function presignR2Upload(filename: string, contentType: string): Promise<{ uploadUrl: string; url: string; expiresIn: number }> {\n  if (!isR2Configured()) throw new StorageUnavailableError('R2 не настроен', 'none');\n  const pathname = buildR2VideoKey(filename);\n  const expiresIn = 600;\n  try {\n    const uploadUrl = await getSignedUrl(\n      r2Client(),\n      new PutObjectCommand({ Bucket: env.r2.bucket, Key: pathname, ContentType: contentType }),\n      { expiresIn },\n    );\n    logger.info({ storage: 'r2', pathname, contentType }, '[Media] выдана ссылка для прямой загрузки в R2');\n    return { uploadUrl, url: r2PublicUrl(pathname), expiresIn };\n  } catch (err) {\n    throw new StorageUnavailableError(`Не удалось подготовить загрузку в R2: ${r2ErrorText(err)}`, 'r2', err);\n  }\n}\n\n/** Понятный текст ошибки S3/R2 без технического мусора. */\nfunction r2ErrorText(err: any): string {\n  const name = err?.name || err?.Code || '';\n  if (name === 'InvalidAccessKeyId' || name === 'SignatureDoesNotMatch') return 'неверные R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY';\n  if (name === 'NoSuchBucket') return `бакет «${env.r2.bucket}» не найден (проверьте R2_BUCKET_NAME)`;\n  if (name === 'AccessDenied') return 'нет доступа — у ключа R2 должно быть право Object Read & Write на этот бакет';\n  if (err?.code === 'ENOTFOUND' || err?.code === 'ECONNREFUSED' || err?.code === 'ETIMEDOUT') return 'нет связи с Cloudflare R2 (проверьте R2_ACCOUNT_ID)';\n  return String(err?.message ?? err);\n}\n\n// ---------------------------------------------------------------------------\n// Загрузка видео кусками через наш сервер (без прямого соединения браузер → Cloudflare).\n// Браузер шлёт куски по ≤4 МБ (предел Vercel на запрос); сервер кладёт каждый во временный\n// объект R2 tmp-upload/<id>/<n>, в конце склеивает в один файл и временные удаляет.\n// Если соединение браузера с Cloudflare рвётся на больших файлах — так видео всё равно доходит,\n// а при обрыве повторяется только один кусок.\n// ---------------------------------------------------------------------------\n\nexport const CHUNK_PREFIX = 'tmp-upload';\nconst chunkKey = (uploadId: string, index: number) => `${CHUNK_PREFIX}/${uploadId}/${String(index).padStart(4, '0')}`;\n\nexport async function r2PutChunk(uploadId: string, index: number, body: Buffer): Promise<void> {\n  if (!isR2Configured()) throw new StorageUnavailableError('R2 не настроен', 'none');\n  try {\n    await r2Client().send(new PutObjectCommand({ Bucket: env.r2.bucket, Key: chunkKey(uploadId, index), Body: body, ContentType: 'application/octet-stream' }));\n  } catch (err) {\n    throw new StorageUnavailableError(`Cloudflare R2 недоступен: ${r2ErrorText(err)}`, 'r2', err);\n  }\n}\n\nasync function readBody(body: any): Promise<Buffer> {\n  if (!body) return Buffer.alloc(0);\n  if (typeof body.transformToByteArray === 'function') return Buffer.from(await body.transformToByteArray());\n  if (Buffer.isBuffer(body)) return body;\n  const parts: Buffer[] = [];\n  for await (const c of body as AsyncIterable<Uint8Array>) parts.push(Buffer.from(c));\n  return Buffer.concat(parts);\n}\n\n/** Склеить куски 0..total-1 в видео, сохранить в R2 и удалить временные куски. */\nexport async function r2CompleteChunks(uploadId: string, total: number, filename: string, contentType: string, maxBytes: number): Promise<{ url: string; bytes: number }> {\n  if (!isR2Configured()) throw new StorageUnavailableError('R2 не настроен', 'none');\n  const keys = Array.from({ length: total }, (_, i) => chunkKey(uploadId, i));\n  const parts: Buffer[] = [];\n  let bytes = 0;\n  try {\n    for (const Key of keys) {\n      const r = await r2Client().send(new GetObjectCommand({ Bucket: env.r2.bucket, Key }));\n      const buf = await readBody((r as any).Body);\n      bytes += buf.length;\n      if (bytes > maxBytes) throw new Error('файл больше допустимого');\n      parts.push(buf);\n    }\n  } catch (err: any) {\n    if (err?.name === 'NoSuchKey') throw new StorageUnavailableError('Не все части видео дошли до сервера — загрузите ещё раз', 'r2', err);\n    if (err instanceof Error && err.message === 'файл больше допустимого') throw new StorageUnavailableError('Видео больше допустимого размера', 'r2', err);\n    throw new StorageUnavailableError(`Cloudflare R2 недоступен: ${r2ErrorText(err)}`, 'r2', err);\n  }\n  const pathname = buildR2VideoKey(filename);\n  try {\n    await r2Client().send(new PutObjectCommand({\n      Bucket: env.r2.bucket, Key: pathname, Body: Buffer.concat(parts), ContentType: contentType,\n      CacheControl: 'public, max-age=31536000, immutable',\n    }));\n  } catch (err) {\n    throw new StorageUnavailableError(`Cloudflare R2 недоступен: ${r2ErrorText(err)}`, 'r2', err);\n  }\n  await r2Client().send(new DeleteObjectsCommand({ Bucket: env.r2.bucket, Delete: { Objects: keys.map((Key) => ({ Key })), Quiet: true } }))\n    .catch((err) => logger.warn({ err: String(err?.message ?? err) }, '[Media] временные куски не удалились'));\n  logger.info({ storage: 'r2', pathname, bytes, chunks: total }, '[Media] видео собрано из кусков и сохранено в R2');\n  return { url: r2PublicUrl(pathname), bytes };\n}\n"],"file":"/src/services/mediaStorage.service.ts"}