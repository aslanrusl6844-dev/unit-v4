AAI,CAAC,CAAC,SAAS;EAAG,MAAM,MAAM,KAAK,KAAK;EAAM,KAAK,MAAM,KAAK,KAAK;CAAK,CAAC;CACxO,MAAM,QAAQ,MAAM,MAAM,EAAE,QAAQ;EAAE,OAAO,IAAI,KAAK,IAAI;EAAK,QAAQ,IAAI,KAAK,IAAI;EAAK,UAAU;EAAG,YAAY;CAAO,EAAE,CAAC,CAAC,CAAC,UAAU,KAAK,CAAC,CAAC,IAAI,CAAC,CAAC,SAAS;CAC9J,8BAAO,UAAU,MAAM,SAAS,KAAK,GAAG;EAAE,MAAM;EAAG,MAAM;CAAE,CAAC;CAC5D,MAAM,QAAQ,MAAM,MAAM,EAAE,GAAG,KAAK,GAAG,GAAG,EAAE,KAAK;EAAE,OAAO;EAAK,QAAQ;EAAK,UAAU;CAAE,EAAE,CAAC,CAAC,CAAC,IAAI,CAAC,CAAC,SAAS;CAC5G,8BAAO,MAAM,MAAM,SAAS,KAAK,GAAG,IAAI;AAC1C,CAAC","names":[],"ignoreList":[],"sources":["telegramAgent.test.ts"],"sourcesContent":["import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { parsePrices, extractJson, detailsSchema } from '../src/services/productAgent.service';\n\ntest('parsePrices', () => {\n  assert.deepEqual(parsePrices('4500 / 6000'), { price: 4500, oldPrice: 6000 });\n  assert.deepEqual(parsePrices('цена 4 500, старая 6 000'), { price: 4500, oldPrice: 6000 });\n  assert.deepEqual(parsePrices('3990'), { price: 3990, oldPrice: undefined });\n  assert.deepEqual(parsePrices('5000 3000'), { price: 5000, oldPrice: undefined });\n  assert.deepEqual(parsePrices('без цифр'), {});\n});\n\ntest('extractJson + schema', () => {\n  const j = extractJson('вот:\\n```json\\n{\"name\":\"Крем\",\"category\":\"Красота\",\"type\":\"Крем\",\"description\":\"ок\"}\\n```');\n  assert.equal((j as any).name, 'Крем');\n  assert.throws(() => extractJson('нет'));\n  assert.equal(detailsSchema.safeParse({ name: 'Крем', category: 'нет такой', type: 'x', description: '' }).success, false);\n});\n\ntest('parseAttachCommand', async () => {\n  const { parseAttachCommand } = await import('../src/services/productDraft.service');\n  assert.equal(parseAttachCommand('детали 1234567'), '1234567');\n  assert.equal(parseAttachCommand('Детали крем для рук'), 'крем для рук');\n  assert.equal(parseAttachCommand('4500 / 6000'), null);\n});\n\ntest('generateScene: разбор ответа Gemini и ошибки', async () => {\n  const { generateScene, buildScenePrompt } = await import('../src/services/geminiImage.service');\n  const png = Buffer.from('89504e47', 'hex');\n  let sent: any;\n  const ok = (async (url: string, init: any) => {\n    sent = { url, body: JSON.parse(init.body), key: init.headers['x-goog-api-key'] };\n    return new Response(JSON.stringify({ candidates: [{ content: { parts: [{ text: 'ok' }, { inlineData: { mimeType: 'image/png', data: png.toString('base64') } }] } }] }), { status: 200 });\n  }) as any;\n  const r = await generateScene({ apiKey: 'K', refs: [{ data: png, mime: 'image/jpeg' }], scene: 'marble table', fetchImpl: ok });\n  assert.equal(r.mime, 'image/png');\n  assert.deepEqual(r.data, png);\n  assert.equal(sent.key, 'K');\n  assert.match(sent.url, /gemini-2\\.5-flash-image:generateContent$/);\n  assert.equal(sent.body.generationConfig.imageConfig.aspectRatio, '3:4');\n  assert.match(buildScenePrompt('x'), /Do NOT add any extra text/);\n  const bad = (async () => new Response('{\"error\":\"quota\"}', { status: 429 })) as any;\n  await assert.rejects(generateScene({ apiKey: 'K', refs: [], scene: 's', fetchImpl: bad }), /Gemini 429/);\n  const empty = (async () => new Response(JSON.stringify({ candidates: [{ finishReason: 'SAFETY', content: { parts: [{ text: 'no' }] } }] }), { status: 200 })) as any;\n  await assert.rejects(generateScene({ apiKey: 'K', refs: [], scene: 's', fetchImpl: empty }), /не вернул картинку \\(SAFETY\\)/);\n});\n\ntest('generateSceneAuto: порядок провайдеров и запасной', async () => {\n  const { generateSceneAuto } = await import('../src/services/geminiImage.service');\n  const png = Buffer.from('89504e47', 'hex');\n  const calls: string[] = [];\n  const f = (async (url: string) => {\n    calls.push(url.includes('openai') ? 'openai' : 'gemini');\n    if (url.includes('generativelanguage')) return new Response('{}', { status: 500 });\n    return new Response(JSON.stringify({ data: [{ b64_json: png.toString('base64') }] }), { status: 200 });\n  }) as any;\n  const r = await generateSceneAuto({ refs: [{ data: png, mime: 'image/jpeg' }], scene: 's', fetchImpl: f, env: { GEMINI_API_KEY: 'g', OPENAI_API_KEY: 'o' } as any });\n  assert.deepEqual(calls, ['gemini', 'openai']);\n  assert.deepEqual(r.data, png);\n  calls.length = 0;\n  await generateSceneAuto({ refs: [], scene: 's', fetchImpl: f, env: { GEMINI_API_KEY: 'g', OPENAI_API_KEY: 'o', IMAGE_PROVIDER: 'openai' } as any });\n  assert.deepEqual(calls, ['openai']);\n  await assert.rejects(generateSceneAuto({ refs: [], scene: 's', env: {} as any }), /нет ключей/);\n});\n\ntest('sniffImageMime', async () => {\n  const { sniffImageMime } = await import('../src/services/geminiImage.service');\n  assert.equal(sniffImageMime(Buffer.from([0xff, 0xd8, 0xff, 0xe0, 0])), 'image/jpeg');\n  assert.equal(sniffImageMime(Buffer.from('89504e470d0a1a0a0000', 'hex')), 'image/png');\n  assert.equal(sniffImageMime(Buffer.from('RIFF\\0\\0\\0\\0WEBPVP8 ')), 'image/webp');\n  assert.equal(sniffImageMime(Buffer.from('xxxxxxxx')), 'image/jpeg');\n});\n\ntest('parseRawCommand', async () => {\n  const { parseRawCommand, parseAttachCommand } = await import('../src/services/productDraft.service');\n  assert.equal(parseRawCommand('картинки 1234567'), '1234567');\n  assert.equal(parseRawCommand('Готовые крем'), 'крем');\n  assert.equal(parseRawCommand('детали 1234567'), null);\n  assert.equal(parseAttachCommand('картинки 1234567'), null);\n});\n\ntest('нарезка листа: команда, сетка, разрезание', async () => {\n  const { parseSliceCommand } = await import('../src/services/productDraft.service');\n  const { parseGrid, splitSheet } = await import('../src/services/sheetSplit.service');\n  assert.deepEqual(parseSliceCommand('нарезать 1234567 2x5'), { query: '1234567', grid: { rows: 2, cols: 5 } });\n  assert.deepEqual(parseSliceCommand('Лист крем для рук'), { query: 'крем для рук', grid: undefined });\n  assert.equal(parseSliceCommand('детали 1234567'), null);\n  assert.deepEqual(parseGrid('2х5'), { rows: 2, cols: 5 });\n  assert.equal(parseGrid('1x1'), null);\n  assert.equal(parseGrid('привет'), null);\n  // лист 2x3: цветные ячейки на белом фоне с промежутками\n  const sharp = (await import('sharp')).default;\n  const cw = 100, ch = 150, gap = 10, cols = 3, rows = 2;\n  const comps: any[] = [];\n  const noise = (seed: number) => { const b = Buffer.alloc(cw * ch * 3); for (let i = 0; i < b.length; i++) b[i] = (i * 37 + seed * 91 + ((i >> 3) % 7) * 20) % 256; return b; };\n  for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {\n    comps.push({ input: await sharp(noise(r * cols + c), { raw: { width: cw, height: ch, channels: 3 } }).png().toBuffer(), left: gap + c * (cw + gap), top: gap + r * (ch + gap) });\n  }\n  const sheet = await sharp({ create: { width: cols * cw + (cols + 1) * gap, height: rows * ch + (rows + 1) * gap, channels: 3, background: '#fff' } }).composite(comps).png().toBuffer();\n  const out = await splitSheet(sheet);\n  assert.deepEqual(out.grid, { rows: 2, cols: 3 });\n  assert.equal(out.slices.length, 6);\n  const m = await sharp(out.slices[0]).metadata();\n  assert.equal(m.width, m.height);\n  assert.equal(m.width, ch); // исходные пиксели: сторона квадрата = большая сторона слайда, без растяжения\n  const raw = await splitSheet(sheet, undefined, false);\n  const rm = await sharp(raw.slices[0]).metadata();\n  assert.ok(Math.abs((rm.width ?? 0) - cw) <= 3 && Math.abs((rm.height ?? 0) - ch) <= 3, `размер ${rm.width}x${rm.height}`);\n});\n\ntest('inferIntent: обычная речь', async () => {\n  const { inferIntent } = await import('../src/services/productDraft.service');\n  const a = inferIntent('Из этой картинки все фотки разъединены на формат один к одному и загрузи этот товар по артикулу 2728897 в детали');\n  assert.equal(a?.article, '2728897');\n  assert.equal(a?.mode, 'slice');\n  assert.equal(inferIntent('артикул 2728897 загрузи как есть')?.mode, 'raw');\n  assert.equal(inferIntent('2728897')?.mode, 'ask');\n  assert.equal(inferIntent('нарезать на 2x5 артикул 2728897')?.grid?.cols, 5);\n  assert.equal(inferIntent('цена 4500 / 6000'), null);\n  assert.equal(parsePrices('артикул 2728897 цена 4500').price, 4500);\n});\n\ntest('peekGrid: лист распознаётся, обычное фото нет', async () => {\n  const { peekGrid } = await import('../src/services/sheetSplit.service');\n  const sharp = (await import('sharp')).default;\n  const n = (seed: number, w: number, h: number) => { const b = Buffer.alloc(w * h * 3); for (let i = 0; i < b.length; i++) b[i] = (i * 37 + seed * 91 + ((i >> 3) % 7) * 20 + ((i / (w * 3)) | 0) * 3) % 256; return b; };\n  const cw = 200, ch = 200, gap = 8;\n  const comps: any[] = [];\n  for (let r = 0; r < 2; r++) for (let c = 0; c < 2; c++) comps.push({ input: await sharp(n(r * 2 + c, cw, ch), { raw: { width: cw, height: ch, channels: 3 } }).png().toBuffer(), left: gap + c * (cw + gap), top: gap + r * (ch + gap) });\n  const sheet = await sharp({ create: { width: 2 * cw + 3 * gap, height: 2 * ch + 3 * gap, channels: 3, background: '#fff' } }).composite(comps).png().toBuffer();\n  assert.deepEqual(await peekGrid(sheet), { rows: 2, cols: 2 });\n  const photo = await sharp(n(5, 600, 600), { raw: { width: 600, height: 600, channels: 3 } }).png().toBuffer();\n  assert.equal(await peekGrid(photo), null);\n});\n"],"file":"/tests/telegramAgent.test.ts"}