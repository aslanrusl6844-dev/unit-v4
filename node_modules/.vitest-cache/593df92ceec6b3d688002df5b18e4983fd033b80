	"Детские товары",
	"Спорт и отдых",
	"Аптека",
	"Канцелярия",
	"Бытовая химия",
	"Транспортные средства",
	"Игры и консоли",
	"Туризм, охота и рыбалка"
];
const SHOP_CATEGORY_SET = new Set(SHOP_CATEGORIES);
