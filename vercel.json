{
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run build && npx prisma migrate deploy",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/cron/sync.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/cron/reprice.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/cron/warm.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    },
    "api/settings/kaspi-store.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 3 * * *" },
    { "path": "/api/cron/reprice", "schedule": "0 4 * * *" }
  ]
}

